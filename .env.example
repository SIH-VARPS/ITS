# Server-side only. Never prefix with VITE_ — Vite inlines those into the client bundle (R8).
# Copy to `.env` (gitignored) or set in the host's environment.
RAILRADAR_API_KEY=
# When the RailRadar key is missing, PNR falls back to a deterministic demo payload.
DEMO_MODE=true
# Monthly RailRadar call cap. At the cap, Tier A is refused and the feed falls back to replay.
RAILRADAR_MONTHLY_QUOTA=1000
# Set to 1 to skip RailRadar entirely (stage rehearsal / air-gapped demo). Tier C ReplayAdapter serves.
LIVE_FEED_DISABLE_VENDOR=
# Shared secret for POST/GET /api/v2/internal/refresh (cron warmer).
INTERNAL_REFRESH_SECRET=
# Browser Maps key. Vite inlines every VITE_* value into client JS.
# Restrict this key by HTTP referrer in Google Cloud; it is not the RailRadar secret.
VITE_GOOGLE_MAPS_API_KEY=
# Comma-separated origins allowed to POST/DELETE /api/v2/*. GET stays *.
# Localhost:3000 and :4173 are always included.
CORS_ALLOWED_ORIGINS=
# Canonical public origin, also added to the mutating CORS allowlist.
APP_URL=
# Error tracking. Leave unset to disable. Server uses SENTRY_DSN; the browser SDK uses VITE_SENTRY_DSN
# (a public client DSN — not the RailRadar key).
SENTRY_DSN=
VITE_SENTRY_DSN=
