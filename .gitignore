# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Secrets — never commit. Server-side keys live in .env / hosting env only.
.env
.env.*
!.env.example

# Harvest corpus (append-only JSONL). Keep the directory, drop the data.
data/harvest/**
!data/harvest/.gitkeep

# ML training rows (regenerated). Keep model.json + fixtures in src/.
ml/data/**
!ml/data/.gitkeep
ml/**/__pycache__/
ml/registry/**
!ml/registry/.gitkeep

# Challenger artifacts. Champion stays src/data/generated/model.json until promotion.
src/data/generated/challenger.json
src/data/generated/models/**
!src/data/generated/models/.gitkeep

# Test / coverage artefacts
coverage
playwright-report
test-results
blob-report
playwright/.cache

